  lines:
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: M-maaf bang..
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Loh, anak baru ya?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Hahaha! Karena lu masih baru disini, lu harus bayar uang tol dulu
      baru boleh masuk!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Sialan.. Padahal baru 2 menit aku disini)
    isThought: 1
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
  - character: {fileID: 11400000, guid: 3b51b1c22931b8a4c867e012f9d2fefd, type: 2}
    speakerNameOverride: 
    dialogueText: Elah, Rico. Pagi-pagi udah malak anak orang aja. Lagi gaada duit
      buat beli rokok?
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Diem lu, Gita! Kagak usah ikut campur urusan gua!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    choices: []
