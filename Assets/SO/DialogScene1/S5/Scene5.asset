    - action: 0
      character: {fileID: 11400000, guid: 77df8e0996b6ffe48a13e4e758e35474, type: 2}
      position: 1
      expression: cemas
      flipX: 0
    - action: 0
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
