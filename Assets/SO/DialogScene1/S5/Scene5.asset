      flipX: 0
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Hahaha! Buka tas lu, pendek! Katanya lu temennya si Mata Empat
      baru itu, kan?!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 77df8e0996b6ffe48a13e4e758e35474, type: 2}
    speakerNameOverride: Radit
    dialogueText: T-tolong, Rico... Aku beneran nggak punya uang lagi...
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
    speakerNameOverride: Rico
    dialogueText: Gua kagak peduli! Gara-gara temen lu si Mata Empat itu belagu nolak
      gua, lu yang harus bayar ganti ruginya! Lagian, kalian sama-sama Mata Empat!
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 2
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
      position: 3
      expression: marah
      flipX: 0
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Tono mengintip dari jendela. Di dalam terlihat jelas bahwa Rico
      menganiaya Radit.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 2502215086801707522, guid: 50f28a2eb4bbfb649b058726ca75469d, type: 3}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands:
    - action: 1
      character: {fileID: 11400000, guid: 5f46f435b99071d48b8cf6d311db3080, type: 2}
      position: 3
      expression: marah
      flipX: 0
    - action: 1
      character: {fileID: 11400000, guid: 77df8e0996b6ffe48a13e4e758e35474, type: 2}
      position: 1
      expression: cemas
      flipX: 0
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: "CCTV di pojok atas kelas terlihat mati \u2014 lampu indikatornya
      padam. "
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
