  - character: {fileID: 11400000, guid: 3b5617a48f58d8c4ca468e81a8bb0bd6, type: 2}
    speakerNameOverride: Tono
    dialogueText: (Sial... Ini salahku. Karena aku menolak Rico tadi, dia malah melampiaskannya
      ke Radit. Kalau dibiarkan, Radit bisa babak belur... Aku harus melakukan sesuatu!)
    isThought: 1
    expression: 
