  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Sore harinya, saat suasana sekolah mulai sepi. Tono yang hendak
      mengambil barangnya yang tertinggal berjalan melintasi koridor menuju ruang
      kelasnya. Tiba-tiba ia mendengar suara gaduh dari dalam kelas.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: 
    isThought: 1
