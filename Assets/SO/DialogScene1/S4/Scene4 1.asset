  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: ???
    dialogueText: Selamat siang, Tono. Benar aku Aris.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 0}
    speakerNameOverride: 
    dialogueText: Aris mengulurkan tangannya untuk berjabat tangan, yang dibalas
      Tono dengan jabat tangan yang canggung. Sensasi dingin tangan Aris seolah menegaskan
      atmosfer ruangan ini.
    isThought: 0
    expression: 
    backgroundOverride: {fileID: 0}
    sfxClip: {fileID: 0}
    sfxVolume: 1
    conditionKey: 
    conditionValue: 
    minigameSceneName: 
    stageCommands: []
    choices: []
  - character: {fileID: 11400000, guid: 183f836956bc50d48904bbf8b612ded2, type: 2}
    speakerNameOverride: Aris
    dialogueText: Aku sengaja memanggilmu ke sini untuk membahas situasi keamananmu
      di SMA Garuda.
    isThought: 0
